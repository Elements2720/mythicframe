# ==========================================
# MythicFrame Environment Configuration
# ==========================================

# GEMINI_API_KEY: (Optional) Required only if using direct Google Gemini API mode.
# If using the BEI browser extension or Pollinations, this can be left blank.
# Obtain a key from: https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# OPENAI_API_KEY: (Optional) Required only if using OpenAI / DALL-E 3 direct API mode.
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# APP_URL: The local URL where MythicFrame is hosted (default: http://localhost:3488)
APP_URL="http://localhost:3488"
